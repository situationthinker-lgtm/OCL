# Local development (SQLite file). For Turso use libsql://<db>-<org>.turso.io and set the token.
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""
# Session signing secret — change this to a long random string before deploying.
AUTH_SECRET="ocl-beta-change-me-in-production-0123456789"
# Vercel Blob token. Leave empty locally to store images in ./uploads instead.
BLOB_READ_WRITE_TOKEN=""
