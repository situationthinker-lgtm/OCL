    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "next": "15.5.29",
    "prisma": "^7.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
